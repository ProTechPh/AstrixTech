# Site configuration (public)
# Canonical site URL used for SEO metadata, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=https://astrixstudio.tech

# Public contact email shown on the site (mailto links, footer).
# [Review: confirm mailbox is live on astrixstudio.tech before launch]
NEXT_PUBLIC_CONTACT_EMAIL=hello@astrixstudio.tech

# Optional public social links (leave unset to hide)
NEXT_PUBLIC_GITHUB_URL=https://github.com/ProTechPh
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/jericko-garcia-689986296

# [Review: Google Play Console developer profile homepage URL currently
# points to jerickogarcia.com — update it to https://astrixstudio.tech
# in Play Console → Developer profile so the Play listing and this site
# reference the same domain.]

# ============================================================
# Contact form delivery (server-only secrets — never expose
# these with the NEXT_PUBLIC_ prefix)
# ============================================================

# Where contact-form email is delivered. Falls back to
# NEXT_PUBLIC_CONTACT_EMAIL when unset. Comma-separated for multiple.
CONTACT_EMAIL_TO=hello@astrixstudio.tech

# --- Option A: Resend (recommended, simplest) ---
# Get a key at https://resend.com — set this to enable Resend.
RESEND_API_KEY=
# Verified "from" address, e.g. "AstrixTech <contact@yourdomain.com>"
SMTP_FROM=

# --- Option B: SMTP fallback (used when RESEND_API_KEY is unset) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ============================================================
# Google Play Testers: Excel & Google Sheets Integration
# ============================================================
# Testers are automatically saved to `data/testers.xlsx` & `data/testers.csv`.
# Download directly at: /api/testers/export (or /api/testers/export?format=csv)

# (Optional) Live Google Sheets / Microsoft Excel Webhook:
# If provided, every new tester submission automatically posts directly
# to your live Google Sheet or Excel Webhook URL.
TESTERS_SHEET_WEBHOOK_URL=

# (Optional) Admin Secret Key to protect /api/testers/export?key=YOUR_SECRET
TESTERS_ADMIN_KEY=

# (Optional) Set to "true" if you also want email notifications sent to CONTACT_EMAIL_TO.
# By default this is false so emails are not sent to your personal inbox.
SEND_TESTER_NOTIFICATIONS=false

# ============================================================
# Cloudflare Turnstile (Bot Protection)
# ============================================================
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Testing keys (always pass in development):
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
